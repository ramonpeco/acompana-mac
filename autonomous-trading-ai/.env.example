# ============================================================================
# Autonomous Crypto Trading AI — configuration (copy to .env; never commit .env)
# ============================================================================

# ---- core -------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
# docker-compose builds DATABASE_URL from POSTGRES_PASSWORD; set it explicitly only without Docker:
# DATABASE_URL=postgresql+asyncpg://trading:PASSWORD@localhost:5432/trading
POSTGRES_PASSWORD=change-me
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Public domain for HTTPS with the bundled Caddy (docker compose --profile https up -d)
DOMAIN=

# ---- auth ---------------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=720
ADMIN_USERNAME=admin
# Either a bcrypt hash (preferred) ...
ADMIN_PASSWORD_HASH=
# ... or a plain password used only to create the admin on first boot (then remove it)
ADMIN_PASSWORD=

# ---- data sources ---------------------------------------------------------------
# live = real public APIs; sandbox = deterministic SYNTHETIC market for testing only
DATA_MODE=live
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_RPS=4
# Recommended: a Helius key (free tier available). Also switches RPC to Helius automatically.
HELIUS_API_KEY=
# Optional Jupiter key (keyless = 0.5 req/s, 60 s window)
JUPITER_API_KEY=
# Reserved for a future Birdeye connector (paid tiers)
BIRDEYE_API_KEY=
STALE_AFTER_SECONDS=120

# ---- agent ----------------------------------------------------------------------
AGENT_AUTOSTART=true
AGENT_TICK_SECONDS=20
DISCOVERY_INTERVAL_MINUTES=30
RANKING_INTERVAL_MINUTES=60
SCANNER_INTERVAL_SECONDS=60
MAX_FOLLOWED_TRADERS=1

# ---- paper trading ------------------------------------------------------------------
INITIAL_CAPITAL_USD=52
RISK_PROFILE=EQUILIBRADO          # CONSERVADOR | EQUILIBRADO | AGRESIVO
COPY_MULTIPLIER=0.25              # position-size scale, NOT leverage
REFERENCE_TRADE_USD=100
SIM_LATENCY_MS=2500
SIM_FAILURE_RATE=0.03
SIM_PRIORITY_FEE_USD=0.002
SIM_DEX_FEE_BPS=25
SIM_SEED=42

# ---- AI -------------------------------------------------------------------------
AI_PROVIDER=anthropic             # anthropic | openai_compatible | none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low                     # low | medium | high
AI_DAILY_CALL_BUDGET=200
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ---- Telegram ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# numeric chat ids; admins can /pause and /resume, notify ids only read
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_NOTIFY_CHAT_IDS=

# ---- live execution (DISABLED; read docs/LIVE_TRADING.md first) ----------------------
LIVE_TRADING_ENABLED=false
LIVE_KEYSTORE_PATH=./keystore/wallet.enc
LIVE_KEYSTORE_PASSPHRASE=
